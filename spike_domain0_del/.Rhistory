# ---------------------------------------------------------
# 3. Create data for top consensus sequence (1st sequence)
# ---------------------------------------------------------
consensus_chars <- strsplit(as.character(seqs_trimmed[[1]]), "")[[1]]
df_consensus <- data.frame(
pos = seq_along(consensus_chars),
aa = consensus_chars,
y = 0,               # Positioned at Y = 0
group = consensus_chars
)
# ---------------------------------------------------------
# 4. Create bar plot data for each sequence (Y = STEP * 1 ... STEP * N)
# ---------------------------------------------------------
plot_data_list <- vector("list", num_seqs)
for (i in seq_len(num_seqs)) {
char_vec <- strsplit(as.character(seqs_trimmed[[i]]), "")[[1]]
# Calculate maximum contiguous gap ('-') length within 1-300 AA
r_gap <- rle(char_vec == "-")
max_gap <- if (any(r_gap$values)) max(r_gap$lengths[r_gap$values]) else 0
# Classify sequences (>= threshold gap: Green, Normal: Blue)
group_name <- if (max_gap >= GAP_THRESHOLD) "Deletion (Green)" else "Normal (Blue)"
# Find start/end positions for non-gap regions (amino acid blocks)
r_seq <- rle(char_vec != "-")
ends <- cumsum(r_seq$lengths)
starts <- c(1, head(ends, -1) + 1)
non_gap_idx <- which(r_seq$values == TRUE)
if (length(non_gap_idx) > 0) {
plot_data_list[[i]] <- data.frame(
xmin = starts[non_gap_idx] - 0.5,
xmax = ends[non_gap_idx] + 0.5,
y = i * STEP,
group = group_name
)
}
}
df_main <- bind_rows(plot_data_list)
# ---------------------------------------------------------
# 5. Set color palette
# ---------------------------------------------------------
aa_colors <- c(
"Normal (Blue)"    = "#4B82C3",
"Deletion (Green)"  = "#7DB656",
"A" = "#80A0F0", "R" = "#F01505", "N" = "#00FF00", "D" = "#C04080",
"C" = "#F08080", "Q" = "#00FF00", "E" = "#C04080", "G" = "#F09000",
"H" = "#15A4A4", "I" = "#80A0F0", "L" = "#80A0F0", "K" = "#F01505",
"M" = "#80A0F0", "F" = "#80A0F0", "P" = "#FFFF00", "S" = "#00FF00",
"T" = "#00FF00", "W" = "#80A0F0", "Y" = "#15A4A4", "V" = "#80A0F0",
"-" = "#E0E0E0"
)
# ---------------------------------------------------------
# 6. Plot with ggplot2
# ---------------------------------------------------------
p <- ggplot() +
# 1. Consensus sequence boxes (grey90 outline)
geom_rect(
data = df_consensus,
aes(xmin = pos - 0.5, xmax = pos + 0.5, ymin = -BAR_HEIGHT, ymax = BAR_HEIGHT, fill = group),
color = "grey90", linewidth = 0.1
) +
# Consensus amino acid letters
geom_text(
data = df_consensus,
aes(x = pos, y = 0, label = aa),
size = 0.8, fontface = "bold", color = "black", family = "Arial"
) +
# 2. Alignment bars for each sequence (grey90 outline)
geom_rect(
data = df_main,
aes(xmin = xmin, xmax = xmax, ymin = y - BAR_HEIGHT, ymax = y + BAR_HEIGHT, fill = group),
color = "grey90", linewidth = 0.1
) +
# 3. Y-axis configuration
scale_y_reverse(
breaks = (0:num_seqs) * STEP,
labels = c("Consensus", seq_names),
expand = c(0, 0)
) +
# 4. X-axis (Amino acid positions 1 to 300)
scale_x_continuous(
limits = c(0.5, MAX_POS + 0.5),
breaks = seq(0, MAX_POS, by = 50),
expand = c(0, 0)
) +
# 5. Color mapping
scale_fill_manual(values = aa_colors) +
# 6. Theme and layout adjustments
labs(
x = "Amino Acid Position",
y = NULL
) +
theme_minimal(base_family = "Arial") +
theme(
panel.grid = element_blank(),
panel.border = element_blank(),
axis.text.y = element_blank(),
axis.ticks.y = element_blank(),
axis.text.x = element_text(size = 9),
axis.title.x = element_text(size = 9),
legend.position = "none",
aspect.ratio = ASPECT_RATIO  # Fix aspect ratio to compress vertical bar height
)
# Display plot
print(p)
# Save plot as SVG file
ggsave("alignment_plot.svg", plot = p, width = 10, height = 3)
