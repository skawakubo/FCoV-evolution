geom_text(
data = df_consensus,
aes(x = pos, y = 0, label = aa),
size = 0.8, fontface = "bold", color = "black", family = "sans"
)
# 3. テキスト形式のままSVG保存（svgliteを指定）
ggsave(
filename = "alignment_plot.svg",
plot = p,
width = 10,
height = 3,
device = svglite::svglite  # テキストのままSVG化します
)
View(df_consensus)
